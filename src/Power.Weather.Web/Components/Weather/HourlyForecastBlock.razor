@namespace Power.Weather.Web.Components.Weather

<section class="section">
    <div class="section__head">
        <h2 class="section__title">Почасовой прогноз</h2>
        <p class="section__hint">Сетка 10 часов в ряд · сегодня и завтра</p>
    </div>

    @if (Hours.Count == 0)
    {
        <p class="section__empty">Нет почасовых данных</p>
    }
    else
    {
        <div class="hourly-groups">
            @foreach (var group in Groups)
            {
                <div class="hourly-day hourly-day--@group.CssSuffix">
                    <div class="hourly-day__label" aria-hidden="true">@group.Title</div>
                    <div class="hourly-day__grid" role="list" aria-label="@group.Title">
                        @foreach (var hour in group.Hours)
                        {
                            <article class="hourly__item" role="listitem">
                                <p class="hourly__param">
                                    <span class="hourly__label">Время</span>
                                    <span class="hourly__value hourly__value--time">@hour.Time.ToString("HH:mm")</span>
                                </p>
                                @if (!string.IsNullOrWhiteSpace(hour.Condition.IconUrl))
                                {
                                    <img src="@hour.Condition.IconUrl" alt="@hour.Condition.Text" width="36" height="36" />
                                }
                                <p class="hourly__param">
                                    <span class="hourly__label">Температура</span>
                                    <span class="hourly__value hourly__value--temp">@hour.TemperatureC.ToString("0")°</span>
                                </p>
                                <p class="hourly__param">
                                    <span class="hourly__label">Дождь</span>
                                    <span class="hourly__value hourly__value--rain">@hour.ChanceOfRainPercent%</span>
                                </p>
                            </article>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<HourlyForecast> Hours { get; set; } = [];

    private IReadOnlyList<HourlyGroup> Groups { get; set; } = [];

    protected override void OnParametersSet()
    {
        Groups = BuildGroups(Hours);
    }

    private static IReadOnlyList<HourlyGroup> BuildGroups(IReadOnlyList<HourlyForecast> hours)
    {
        if (hours.Count == 0)
        {
            return [];
        }

        var byDate = hours
            .GroupBy(h => h.Time.Date)
            .OrderBy(g => g.Key)
            .ToList();

        var result = new List<HourlyGroup>(byDate.Count);
        for (var i = 0; i < byDate.Count; i++)
        {
            var day = byDate[i];
            result.Add(new HourlyGroup(
                Title: i == 0 ? "Сегодня" : i == 1 ? "Завтра" : day.Key.ToString("dd.MM"),
                CssSuffix: i == 0 ? "today" : "tomorrow",
                Hours: day.ToList()));
        }

        return result;
    }

    private sealed record HourlyGroup(string Title, string CssSuffix, IReadOnlyList<HourlyForecast> Hours);
}
