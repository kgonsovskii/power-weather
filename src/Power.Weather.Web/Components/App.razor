<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Power.Weather.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
    <style>
        html, body { margin: 0; min-height: 100%; }
        #pw-boot {
            position: fixed; inset: 0; z-index: 9999;
            display: grid; place-items: center;
            background: linear-gradient(145deg, #0a2a55 0%, #1467b8 35%, #ff6a12 75%, #ffd000 100%);
        }
        #pw-boot[hidden] { display: none !important; }
        #pw-boot .pw-boot-wheel {
            width: min(16rem, 70vw); height: min(16rem, 70vw);
            border-radius: 50%;
            background: repeating-conic-gradient(from 0deg, #111 0 10deg, #2a2a2a 10deg 14deg);
            border: 8px solid #ffe000;
            box-shadow: inset 0 0 0 28px #111, inset 0 0 0 34px #ffe000, 0 12px 0 rgba(0,0,0,.35);
            animation: pw-boot-spin 4.2s linear infinite;
            position: relative;
        }
        #pw-boot .pw-boot-wheel::after {
            content: "";
            position: absolute; inset: 34%;
            border-radius: 50%;
            background: #ffe000;
            box-shadow: 0 0 0 4px #111;
        }
        #pw-boot .pw-boot-caption {
            margin-top: 1.25rem;
            text-align: center;
            font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
            color: #ffe000;
            font-size: 2rem;
            letter-spacing: .08em;
            text-shadow: 3px 3px 0 #000;
        }
        #pw-boot .pw-boot-sub {
            margin-top: .35rem;
            font-family: Arial, sans-serif;
            color: #fff;
            letter-spacing: .16em;
            text-transform: uppercase;
            font-weight: 700;
        }
        @@keyframes pw-boot-spin { to { transform: rotate(360deg); } }
    </style>
</head>

<body>
    <div id="pw-boot" aria-busy="true" aria-live="polite">
        <div style="display:grid;justify-items:center;">
            <div class="pw-boot-wheel" aria-hidden="true"></div>
            <div class="pw-boot-caption">ЗАГРУЗКА</div>
            <div class="pw-boot-sub">ПОГОДА СВЯЗЬ</div>
        </div>
    </div>

    <Routes />
    <ReconnectModal />

    <script>
        window.pwBootHide = function () {
            var el = document.getElementById('pw-boot');
            if (el) {
                el.setAttribute('hidden', '');
                el.remove();
            }
        };

        (function () {
            function maybeHide() {
                // Передаём управление только когда UI загрузки Blazor уже на экране — не на пререндере weather-page.
                if (document.querySelector('.tire-loader')) {
                    window.pwBootHide();
                    return true;
                }
                return false;
            }

            var obs = new MutationObserver(function () {
                if (maybeHide()) obs.disconnect();
            });
            obs.observe(document.documentElement, { childList: true, subtree: true });
            maybeHide();
        })();
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
